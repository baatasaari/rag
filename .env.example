# ── Environment ───────────────────────────────────────────────────────────────
RAG_ENV=development                       # development | staging | production
RAG_CONFIG_DIR=./config                   # path to config/ directory

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=lbg-rag-dev
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# ── Storage ───────────────────────────────────────────────────────────────────
ALLOYDB_CONNECTION=postgresql+asyncpg://rag_user:password@localhost:5432/rag_platform
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# ── Source connectors (leave blank if unused) ──────────────────────────────────
CONFLUENCE_URL=
SHAREPOINT_TENANT_ID=
VERTEX_SEARCH_DATA_STORE_ID=

# ── Third-party APIs ──────────────────────────────────────────────────────────
COHERE_API_KEY=
